# 钱迹 SDK / API / MCP 服务配置模板
# 复制为 .env 后按需修改；compose 会自动读取同目录 .env。
# cp .env.example .env

# ---- HTTP API 服务（qianji-api / scripts/run_api.py）----
# 监听地址。源码默认 127.0.0.1（仅本机）；Docker 镜像内默认 0.0.0.0（Dockerfile/compose 显式设置）
QIANJI_HOST=127.0.0.1
# 监听端口
QIANJI_PORT=50003
# 本地开发启用 uvicorn reload：1/true/yes/on
# QIANJI_RELOAD=

# ---- 独立 MCP HTTP 服务（qianji-mcp-http / scripts/run_mcp_http.py，端口独立于主服务）----
# 注意：docker-compose 不读这三项；仅手动 export 或本地运行 qianji-mcp-http 时生效
MCP_HOST=127.0.0.1
MCP_PORT=50004
MCP_PATH=/mcp

# ---- 存储 ----
# SQLite session 存储路径；本地默认项目根目录 .qianji.db，Docker 为 /app/data/.qianji.db
# QIANJI_DB_PATH=

# ---- 日志与网络 ----
# 日志级别：DEBUG/INFO/WARNING/ERROR
QIANJI_LOG_LEVEL=INFO
# 上游请求超时（秒）
QIANJI_TIMEOUT=30.0
# 上游连接池
QIANJI_MAX_CONNECTIONS=20
QIANJI_MAX_KEEPALIVE=10

# ---- 账单缓存 ----
# 账单缓存软 TTL（秒）：超过此时长查账自动增量同步；0 禁用（信任缓存直到显式同步）
QIANJI_BILL_CACHE_TTL=300

# ---- 导出文件 ----
# 导出账单/报表图片等临时文件保留天数
QIANJI_FILE_RETENTION_DAYS=7
# 生成下载链接时使用的对外 base URL（如 https://qianji.example.com），留空则用相对路径；
# 对 REST 导出（/bills/export）和报表图片下载链接同样生效
# QIANJI_PUBLIC_BASE_URL=

# ---- 认证与安全 ----
# 认证失败限流：窗口内连续失败达到上限后锁定。MCP 入口与 REST 入口分别计数
# QIANJI_MCP_AUTH_FAILURE_LIMIT=10
# QIANJI_MCP_AUTH_FAILURE_WINDOW=60
# QIANJI_AUTH_FAILURE_LIMIT=30
# QIANJI_AUTH_FAILURE_WINDOW=300
# 信任的反向代理 IP（逗号分隔）；默认空 = 不信任 X-Forwarded-For，限流按直接连接 IP 计数。
# Traefik 等反代部署必须显式设置（如 Traefik 出口 IP 或网段），否则所有用户共享代理 IP 的限流额度
# QIANJI_FORWARDED_ALLOW_IPS=
# 已保存 session 的最大复用天数，超过后强制重新登录；0 = 禁用该限制
# QIANJI_SESSION_MAX_AGE_DAYS=30

# ---- 图片上传 ----
# 七牛上传地址覆盖（默认 https://upload.qiniup.com，可按区域换成其他七牛上传域名）
# QIANJI_QINIU_UPLOAD_URL=

# ---- MCP ----
# 服务默认 MCP 工具范围：read / write / advanced / full
QIANJI_MCP_MODE=advanced

# ---- Docker / compose ----
# compose 使用的镜像标签
QIANJI_IMAGE_TAG=0.0.30
# 容器内进程 UID/GID（与命名卷属主对齐）
# PUID=1000
# PGID=1000
# 容器时区
TZ=Asia/Shanghai
# Traefik 部署时的域名与应用名（仅默认 docker-compose.yml 使用）
# DOMAIN=qianji.example.com
# AppName=mcp_qianji
